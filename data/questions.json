[
 {
  "id": "633867211295687253",
  "date": "2026-09-29",
  "time": "10:33",
  "question": "なんでチーソーになる？",
  "extra": [
   "なんで7mがいらない？"
  ],
  "quote": null,
  "images": [
   "633867211731894307.jpg"
  ],
  "inherited": false,
  "answers": [
   {
    "id": "633917116785623485",
    "time": "09/29 18:49",
    "text": "6s切っちゃうとこのままテンパイするときに4sが出ていっちゃうんですね、これが普通に危ない\n\n自分の目から6sが全部見えてるんでこの7sってあんま刺さらないです\n7sを2枚切っていくうちに4-7mか5s引ければ安全にテンパイがとれますね\n（中筋になってる6pにバーが伸びてるのもそういう理由です（そこそこ安全で2枚切ってるうちにテンパイできるルートが残る））"
   }
  ]
 },
 {
  "id": "633877217462190083",
  "date": "2026-09-29",
  "time": "12:12",
  "question": "22,33の方が泣きやすそうじゃない？",
  "extra": [],
  "quote": null,
  "images": [
   "633875427852550316.jpg"
  ],
  "inherited": false,
  "answers": [
   {
    "id": "633917679845507093",
    "time": "09/29 18:54",
    "text": "おりていそうに見える\n\n特に枚数が減ってるわけでもないリャンメンチーからはいってるので結構警戒したい（＊）かも\n＊また後で書きます",
    "note": "画像への返信（紐付けは推定）"
   },
   {
    "id": "633917774855144173",
    "time": "09/29 18:55",
    "text": "鳴きやすそうっていうかテンパイですね\n\nこれ人は1p切るんですがこれ3pなんだ…すごいな"
   },
   {
    "id": "633918135548510431",
    "time": "09/29 18:59",
    "text": "あと送ってくれている牌譜とは関係ないんですが\n「相手がチンイツっぽい」とか「相手の切り方が変だ」みたいなのを最近ちょこちょこ言ってると思いますが、相手の手開けて答え合わせするようにしてみてください\n\n結果論に引っ張られないように検討の時は相手の手は開けないでね、みたいなことを昔言った気がしますがもう手牌あけつつ振り返りをしてもいい気がしました",
    "note": "補足"
   }
  ]
 },
 {
